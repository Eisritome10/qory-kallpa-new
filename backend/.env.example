# PostgreSQL (Supabase) - connection pooling (pgbouncer) para runtime
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
# Conexion directa (sin pooling) usada por Prisma Migrate
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[HOST]:5432/postgres"

# JWT
JWT_SECRET="reemplaza-con-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="8h"

# Supabase Storage
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="reemplaza-con-tu-service-role-key"
SUPABASE_CV_BUCKET="cv-postulantes"

# CORS
FRONTEND_URL="https://www.qorikallpa.org"
# Opcional: origenes adicionales separados por coma (ej. previews de Vercel)
CORS_EXTRA_ORIGINS="https://qori-kallpa.vercel.app"

# Envio de correos (verificacion de cuenta y notificaciones de estado) via Resend
RESEND_API_KEY="reemplaza-con-tu-api-key-de-resend"
# Remitente. Sin un dominio verificado en Resend, solo puedes usar el sandbox
# "onboarding@resend.dev", que unicamente entrega correos a la cuenta dueña del API key.
EMAIL_FROM="Qori Kallpa <onboarding@resend.dev>"

# Servidor
PORT=3000
